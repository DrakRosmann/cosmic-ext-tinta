[Desktop Entry]
Name=Tinta
GenericName=Code Editor
GenericName[pt_BR]=Editor de código
Comment=A code editor for the COSMIC desktop, with syntax highlighting, language servers, git and a terminal
Comment[pt_BR]=Um editor de código para o COSMIC, com destaque de sintaxe, servidores de linguagem, git e terminal
Type=Application
Exec=@bindir@/cosmic-ext-tinta %F
Terminal=false
Categories=COSMIC;Development;TextEditor;IDE;
Keywords=COSMIC;Editor;Code;Text;Programming;Rust;Sublime;VSCode;
MimeType=text/plain;text/x-csrc;text/x-chdr;text/x-c++src;text/x-rust;text/x-python;text/markdown;application/json;application/x-shellscript;application/xml;text/html;text/css;application/javascript;application/toml;
StartupNotify=true
StartupWMClass=io.github.DrakRosmann.CosmicExtTinta
Icon=io.github.DrakRosmann.CosmicExtTinta
